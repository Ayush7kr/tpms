# Copy this file to .env and fill in what you need. Every value is optional for local use.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Demo mode adds one-click sign-in buttons for each role on the login page.
# Anyone can use them to sign in as admin, so turn this off on a real server.
DEMO_MODE=True

# AI career assistant. Without a key, the assistant answers from built-in guidance.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Institution details shown in the interface
TPMS_INSTITUTE_NAME="Apex Institute of Technology"
TPMS_INSTITUTE_SHORT_NAME="AIT"
TPMS_CURRENT_ACADEMIC_YEAR="2025-26"
