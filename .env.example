# ==============================================================================
# TPMS — Training & Placement Management System Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Update with your actual deployment configuration and institutional keys.
# 3. Never commit the actual '.env' containing real secrets to version control.
# ==============================================================================

# Django Secret Key (Use a cryptographically secure random string in production)
DJANGO_SECRET_KEY=django-insecure-tpms-apex-institute-development-key-2025

# Debug Mode (Set to False for production deployment)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames or IP addresses)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to SQLite; configure for PostgreSQL/MySQL in production)
# DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------------------------
# Google Gemini Generative AI Configuration (Feature: AI Career Assistant)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If omitted or left blank, the TPMS Career Assistant will automatically operate
# in Institutional Guidance Mode (fully personalized rule-based career guidance).
GEMINI_API_KEY=your-google-gemini-api-key-here

# Default Academic Year & Institution Metadata
TPMS_INSTITUTE_NAME="Apex Institute of Technology"
TPMS_INSTITUTE_SHORT_NAME="AIT"
TPMS_CURRENT_ACADEMIC_YEAR="2025-2026"
